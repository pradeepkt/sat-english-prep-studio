datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Domain {
  CRAFT_AND_STRUCTURE
  INFORMATION_AND_IDEAS
  STANDARD_ENGLISH_CONVENTIONS
  EXPRESSION_OF_IDEAS
}

enum SubSkill {
  WORDS_IN_CONTEXT
  TEXT_STRUCTURE_AND_PURPOSE
  CROSS_TEXT_CONNECTIONS
  CENTRAL_IDEAS_AND_DETAILS
  COMMAND_OF_EVIDENCE_TEXTUAL
  COMMAND_OF_EVIDENCE_QUANTITATIVE
  INFERENCES
  BOUNDARIES_AND_PUNCTUATION
  FORM_STRUCTURE_AND_SENSE
  RHETORICAL_SYNTHESIS
  TRANSITIONS
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TestStatus {
  NOT_STARTED
  IN_PROGRESS
  ABANDONED
  COMPLETED
}

model Question {
  id              String         @id @default(cuid())
  sourceName      String
  sourceUrl       String?
  domain          Domain
  subSkill        SubSkill
  difficulty      Difficulty
  passage         String         @db.Text
  prompt          String         @db.Text
  options         Json
  correctOption   String
  staticRationale String         @db.Text
  testQuestions   TestQuestion[]
  createdAt       DateTime       @default(now())
}

model TestSession {
  id               String         @id @default(cuid())
  title            String
  totalQuestions   Int            @default(54)
  totalTimeMinutes Int            @default(64)
  status           TestStatus     @default(NOT_STARTED)
  currentModule    Int            @default(1)
  timeRemainingSec Int            @default(3840)
  scoreRaw         Int?
  scoreScaled      Int?
  startedAt        DateTime?
  completedAt      DateTime?
  abandonedAt      DateTime?
  isAdaptiveFocus  Boolean        @default(false)
  testQuestions    TestQuestion[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model TestQuestion {
  id                   String      @id @default(cuid())
  testSessionId        String
  testSession          TestSession @relation(fields: [testSessionId], references: [id], onDelete: Cascade)
  questionId           String
  question             Question    @relation(fields: [questionId], references: [id])
  moduleNumber         Int
  orderIndex           Int
  selectedOption       String?
  isFlaggedForReview   Boolean     @default(false)
  timeSpentSeconds     Int         @default(0)
  eliminatedOptions    String[]
  isCorrect            Boolean?
  dynamicAiAnalysis    String?     @db.Text
  cognitiveMistakeType String?
}

model StudentDomainProficiency {
  id                  String   @id @default(cuid())
  domain              Domain   @unique
  totalAttempted      Int      @default(0)
  totalCorrect        Int      @default(0)
  accuracyRate        Float    @default(0.0)
  avgTimeSpentSeconds Float    @default(0.0)
  lastUpdated         DateTime @updatedAt
}
